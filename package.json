{
  "name": "colonization",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data:import": "node packages/data/src/cli.ts",
    "data:review": "node packages/data/src/cli.ts --review",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web",
    "fuzz": "node packages/lab/src/fuzz.ts",
    "systems": "node packages/lab/src/systems.ts",
    "web": "pnpm web:build && node packages/web/tools/serve.ts",
    "web:build": "rolldown packages/web/src/main.ts --format esm --minify --sourcemap -o packages/web/dist/app.js",
    "web:watch": "rolldown packages/web/src/main.ts --format esm --sourcemap -o packages/web/dist/app.js --watch",
    "replay": "node packages/lab/src/replay.ts",
    "watch": "node packages/lab/src/watch.ts",
    "experiments": "node packages/lab/src/experiments.ts",
    "tune": "node packages/lab/src/tune.ts",
    "check": "pnpm data:import && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "fast-check": "^4.11.0",
    "read-excel-file": "^9.3.20",
    "rolldown": "1.2.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
