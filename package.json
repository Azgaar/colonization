{
  "name": "colonization",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "rules:build": "node packages/data/src/cli.ts",
    "rules:review": "node packages/data/src/cli.ts --review",
    "rules:sheet": "node packages/data/src/sheet.ts",
    "rulebook": "node rulebook/build.ts",
    "rules": "node packages/data/src/rules.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web && tsc --noEmit -p packages/web/sw && pnpm lab:typecheck",
    "fuzz": "node packages/lab/src/fuzz.ts",
    "systems": "node packages/lab/src/systems.ts",
    "web": "pnpm web:build && node packages/web/tools/serve.ts",
    "web:build": "rolldown packages/web/src/main.ts --format esm --minify --sourcemap -o packages/web/dist/app.js && rolldown packages/lab/src/worker.ts --format esm --minify -o packages/web/dist/lab-worker.js && node packages/web/tools/sounds.ts && rolldown packages/web/sw/sw.ts --format esm --minify -o packages/web/dist/sw.js && node packages/web/tools/pwa.ts",
    "web:watch": "rolldown packages/web/src/main.ts --format esm --sourcemap -o packages/web/dist/app.js --watch",
    "replay": "node packages/lab/src/replay.ts",
    "watch": "node packages/lab/src/watch.ts",
    "experiments": "node packages/lab/src/experiments.ts",
    "tune": "node packages/lab/src/tune.ts",
    "sweep": "node packages/lab/src/sweep.ts",
    "detect": "node packages/lab/src/detect.ts",
    "strength:search": "node packages/lab/src/search-strength.ts",
    "seat": "node packages/lab/src/seat.ts",
    "proposals": "node packages/lab/src/proposals.ts",
    "lab:typecheck": "tsc --noEmit -p packages/lab/tsconfig.browser.json",
    "check": "pnpm rules:build && pnpm typecheck && pnpm test",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "fast-check": "^4.11.0",
    "read-excel-file": "^9.3.20",
    "rolldown": "1.2.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
