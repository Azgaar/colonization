{
  // Used by tools/check.mjs, which keeps only missing, unused and duplicate names.
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "checkJs": true, "noEmit": true, "noUnusedLocals": true, "strict": false, "noImplicitAny": false, "skipLibCheck": true
  },
  "include": ["src"]
}
